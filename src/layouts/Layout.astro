---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = `${site.name} | Cosmiatría & Estilismo en Lima`,
    description = "Cosmiatría facial, cuidado de la piel y estilismo personalizado en Lima. Atención a domicilio con cita previa.",
} = Astro.props;

const content = {
    skipLink: "Saltar al contenido principal",
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="theme-color" content="#fbf9f5" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_CL" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="preload"
            href="/fonts/material-symbols-subset.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <title>{title}</title>
    </head>
    <body class="min-h-dvh bg-background font-body-md text-body-md text-on-surface antialiased">
        <a
            href="#inicio"
            class="sr-only z-100 rounded-lg bg-primary px-4 py-3 font-label-md text-label-md text-on-primary focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
        >
            {content.skipLink}
        </a>
        <slot />
    </body>
</html>
