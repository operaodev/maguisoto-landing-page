---
import "../styles/global.css";
import { services } from "../data/services";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} | Cosmiatría & Estilismo en Lima`,
  description = "Cosmiatría facial, estilismo, cejas y pestañas a domicilio en Lima. Agenda tu evaluación personalizada con Magui Soto.",
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL("/og-image.jpg", siteUrl).toString();
const logoUrl = new URL("/favicon.svg", siteUrl).toString();
const ogImageAlt = `${site.name} — Cosmiatría y estilismo en Lima`;

const prices = services
  .map((service) => Number(service.price.replace(/[^\d]/g, "")))
  .filter((price) => Number.isFinite(price) && price > 0);
const priceRange = prices.length
  ? `S/ ${Math.min(...prices)} - S/ ${Math.max(...prices)}`
  : "S/ 60 - S/ 850";

const openingHours = [
  {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "19:30",
  },
  {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: "Saturday",
    opens: "10:00",
    closes: "14:00",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl.origin}/#website`,
      url: siteUrl.origin,
      name: `${site.name} | Cosmiatría & Estilismo`,
      inLanguage: "es-PE",
      publisher: { "@id": `${siteUrl.origin}/#business` },
    },
    {
      "@type": "BeautySalon",
      "@id": `${siteUrl.origin}/#business`,
      name: site.name,
      alternateName: "Magui Soto Cosmiatría & Estilismo",
      description:
        "Cosmiatría facial, estilismo, cejas, pestañas y tratamientos corporales a domicilio en Lima. Atención personalizada con Magui Soto.",
      url: siteUrl.origin,
      image: ogImage,
      logo: logoUrl,
      telephone: `+${site.whatsapp}`,
      priceRange,
      currenciesAccepted: "PEN",
      paymentAccepted: "Yape, Plin, Efectivo, Transferencia",
      slogan: "Luce una piel radiante y un estilo que habla por ti.",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Lima",
        addressRegion: "Lima",
        addressCountry: "PE",
      },
      areaServed: { "@type": "City", name: "Lima" },
      serviceArea: { "@type": "City", name: "Lima" },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: `+${site.whatsapp}`,
        contactType: "customer service",
        availableLanguage: ["Spanish"],
      },
      openingHoursSpecification: openingHours,
      founder: {
        "@type": "Person",
        name: site.name,
        jobTitle: site.credential,
      },
      employee: {
        "@type": "Person",
        name: site.name,
        jobTitle: site.credential,
      },
      knowsAbout: [
        "Cosmiatría facial",
        "Estilismo",
        "Microblading y shading",
        "Extensiones de pestañas",
        "Limpieza facial",
        "Tratamientos corporales",
        "Maquillaje profesional",
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios de cosmiatría y estilismo",
        itemListElement: services.map((service, index) => ({
          "@type": "Offer",
          position: index + 1,
          priceCurrency: "PEN",
          availability: "https://schema.org/InStock",
          priceSpecification: {
            "@type": "PriceSpecification",
            priceCurrency: "PEN",
            minPrice: Number(service.price.replace(/[^\d]/g, "")),
          },
          itemOffered: {
            "@type": "Service",
            name: service.name,
            description: service.description,
            serviceType: service.category,
            provider: { "@id": `${siteUrl.origin}/#business` },
          },
        })),
      },
    },
  ],
};

const content = {
  skipLink: "Saltar al contenido principal",
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbf9f5" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={site.name} />
    <meta name="geo.region" content="PE-LIM" />
    <meta name="geo.placename" content="Lima" />
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-PE" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/fonts/material-symbols-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={`${site.name} | Cosmiatría & Estilismo`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://wa.me" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>

    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-background font-body-md text-body-md text-on-surface antialiased">
    <a
      href="#inicio"
      class="sr-only z-100 rounded-lg bg-primary px-4 py-3 font-label-md text-label-md text-on-primary focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      {content.skipLink}
    </a>
    <slot />
  </body>
</html>
