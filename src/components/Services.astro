---
import { Image } from "astro:assets";
import { services } from "../data/services";

const content = {
  eyebrow: "Cosmiatría, Estética & Estilismo",
  title: "Tratamientos Faciales, Corporales & Estilismo",
  description:
    "Protocolos personalizados de cosmiatría, estética facial y corporal, cejas, pestañas y estilismo integral. Los procedimientos invasivos se realizan previa evaluación y con seguimiento.",
  meta: "Atención a domicilio • Cita previa",
  bookingLabel: "Reservar este servicio",
};

const badgeClasses = {
  secondary: "bg-secondary-container text-on-secondary-container",
  primary: "bg-primary-fixed text-on-primary-fixed",
  tertiary: "bg-tertiary-fixed text-on-tertiary-fixed",
} as const;
---

<section id="servicios" class="section-shell bg-surface">
  <div class="container-page">
    <div class="mb-space-xl flex flex-col justify-between gap-space-md md:flex-row md:items-end">
      <div class="max-w-3xl">
        <span class="eyebrow">{content.eyebrow}</span>
        <h2 class="section-title mt-space-xs">{content.title}</h2>
        <p class="mt-space-xs font-body-lg text-body-lg text-on-surface-variant">{content.description}</p>
      </div>
      <div class="flex items-center gap-space-xs self-start md:self-end">
        <span class="material-symbols-outlined text-[20px] text-primary" aria-hidden="true">tune</span>
        <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline">{content.meta}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-gutter md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="group flex flex-col overflow-hidden rounded-xl border border-outline-variant/25 bg-surface-container-low shadow-card transition-all duration-300 hover:-translate-y-0.5 hover:shadow-float">
            <div class="relative hidden h-60 w-full overflow-hidden bg-surface-container md:block">
              <Image
                src={service.image}
                alt={service.imageAlt}
                widths={[320, 480]}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute right-3 top-3 rounded-md bg-surface-container-lowest/90 px-2.5 py-1 shadow-card backdrop-blur-md">
                <span class="font-title-md text-[14px] font-bold text-primary">{service.price}</span>
              </div>
              <div class={`absolute bottom-3 left-3 rounded-full px-2.5 py-1 font-label-sm text-[10px] font-semibold uppercase tracking-wider ${badgeClasses[service.badgeTone]}`}>
                {service.category}
              </div>
            </div>

            <div class="flex flex-1 flex-col justify-between p-space-lg">
              <div>
                <div class="mb-space-sm flex items-start justify-between gap-2 md:hidden">
                  <span class={`rounded-full px-2.5 py-1 font-label-sm text-[10px] font-semibold uppercase tracking-wider ${badgeClasses[service.badgeTone]}`}>
                    {service.shortCategory}
                  </span>
                  <span class="shrink-0 rounded bg-surface-container-high px-2.5 py-1 font-label-md text-label-md font-semibold text-on-surface">
                    {service.price}
                  </span>
                </div>

                <div class="mb-space-xs flex flex-col gap-2 font-label-sm text-label-sm text-outline sm:flex-row sm:flex-wrap sm:items-center sm:gap-space-xs">
                  <span class="inline-flex items-center gap-space-xs">
                    <span class="material-symbols-outlined text-[16px]" aria-hidden="true">schedule</span>
                    <span>{service.duration}</span>
                  </span>
                  <span class="hidden text-outline-variant sm:inline" aria-hidden="true">•</span>
                  <span>{service.skinType}</span>
                </div>

                <h3 class="mb-space-xs font-headline-sm text-headline-sm text-on-surface transition-colors group-hover:text-primary">
                  {service.name}
                </h3>

                <p class="mb-space-md font-body-sm text-body-sm leading-relaxed text-on-surface-variant md:hidden">
                  {service.summary}
                </p>
                <p class="mb-space-md hidden font-body-sm text-body-sm leading-relaxed text-on-surface-variant md:block">
                  {service.description}
                </p>

                <div class="mb-space-md flex flex-wrap gap-1.5">
                  {service.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>

              <a
                href="#contacto"
                data-service={service.id}
                aria-label={`${content.bookingLabel}: ${service.name}`}
                class="inline-flex w-full items-center justify-center gap-space-xs rounded-lg bg-surface-container-highest px-space-md py-2.5 font-label-md text-label-md font-semibold uppercase tracking-wider text-on-surface shadow-card transition-colors hover:bg-primary hover:text-on-primary"
              >
                {content.bookingLabel}
                <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
